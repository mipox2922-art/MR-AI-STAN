{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mr-ai-stan-api",
  "main": "container-worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "containers": [
    {
      "class_name": "MrAiApiContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MR_AI_API_CONTAINER",
        "class_name": "MrAiApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MrAiApiContainer"
      ]
    }
  ],
  "vars": {
    "CORS_ORIGINS": "https://mr-ai-stan.pages.dev",
    "SERVERLESS_MODE": "false",
    "SCHEDULER_ENABLED": "false",
    "GMAIL_CLIENT_ID": "915582116434-57794p02eorjkpmrbu2ian4r9btclo8f.apps.googleusercontent.com",
    "GMAIL_REDIRECT_URI": "https://mr-ai-stan.pages.dev/api/integrations/gmail/callback",
    "GMAIL_SCOPES": "https://www.googleapis.com/auth/gmail.readonly"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
