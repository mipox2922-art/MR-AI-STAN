{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mr-ai-stan-api",
  "main": "worker.py",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "python_workers"
  ],
  "vars": {
    "CORS_ORIGINS": "https://mr-ai-stan.pages.dev",
    "SERVERLESS_MODE": "true"
  },
  "secrets": {
    "required": [
      "SECRET_KEY",
      "DATABASE_URL"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
