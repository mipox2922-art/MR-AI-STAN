{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mr-ai-stan-api",
  "main": "worker.py",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "python_workers"
  ],
  "vars": {
    "CORS_ORIGINS": "https://mr-ai-stan.pages.dev",
    "SERVERLESS_MODE": "true",
    "GMAIL_CLIENT_ID": "915582116434-57794p02eorjkpmrbu2ian4r9btclo8f.apps.googleusercontent.com",
    "GMAIL_REDIRECT_URI": "https://mr-ai-stan.pages.dev/api/integrations/gmail/callback",
    "GMAIL_SCOPES": "https://www.googleapis.com/auth/gmail.readonly"
  },
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/__pycache__",
      "**/tests/**",
      "**/test/**",
      "**/docs/**",
      "**/doc/**",
      "**/*.pyi",
      "**/*.dist-info/**",
      "**/*.egg-info/**"
    ]
  },
  "secrets": {
    "required": [
      "SECRET_KEY",
      "DATABASE_URL"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
