SECRET_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

KIMI_API_KEY=
KIMI_MODEL=kimi-k2
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Local development:
DATABASE_URL=sqlite:///./mr_ai.db

# Supabase Session Pooler (IPv4) example:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres
# Optional trusted CA: PEM text or a path to a PEM file. Never disable TLS verification.
# DATABASE_SSL_CA_CERT=

# Cloudflare Container scheduler authentication (Cloudflare secret in production)
# CLOUDFLARE_CRON_SECRET=
SCHEDULER_ENABLED=true
SERVERLESS_MODE=false

CORS_ORIGINS=http://localhost:5173

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
