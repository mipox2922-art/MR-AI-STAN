SECRET_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

KIMI_API_KEY=
KIMI_MODEL=kimi-k2
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Local development:
DATABASE_URL=sqlite:///./mr_ai.db

# Production: use a reachable PostgreSQL database (any compatible provider).
# Cloudflare Container disks are ephemeral; SQLite is for local development only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional custom trusted CA PEM text or mounted PEM path. Never disable TLS verification.
# DATABASE_SSL_CA_CERT=

SCHEDULER_ENABLED=true
SERVERLESS_MODE=false
CLOUDFLARE_CRON_SECRET=

CORS_ORIGINS=http://localhost:5173

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
